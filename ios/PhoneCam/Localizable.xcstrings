{
  "sourceLanguage": "ja",
  "strings": {
    "wireless.scan.title": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QRコードを読み取る"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan QR code"
          }
        }
      }
    },
    "wireless.scan.prompt": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PC に表示された PhoneCam の QR コードを映してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point the camera at the PhoneCam QR code shown on your PC."
          }
        }
      }
    },
    "wireless.scan.camera_error": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラを開けません。カメラのアクセス許可を確認してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot open the camera. Check camera permissions."
          }
        }
      }
    },
    "wireless.scan.confirm": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この PC にペアリングコードを送信します。PC 名を確認してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pairing code will be sent to this PC. Check its name before continuing."
          }
        }
      }
    },
    "wireless.scan.pair": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングする"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair"
          }
        }
      }
    },
    "wireless.scan.retry": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度読み取る"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan again"
          }
        }
      }
    },
    "wireless.scan.close": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        }
      }
    },
    "wireless.scan.invalid": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PhoneCam のペアリング用 QR コードではありません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not a PhoneCam pairing QR code."
          }
        }
      }
    },
    "wireless.scan.sending": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PC に接続しています…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacting the PC…"
          }
        }
      }
    },
    "wireless.scan.success": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PC とペアリングしました"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paired with the PC"
          }
        }
      }
    },
    "wireless.scan.failed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PC に接続できませんでした。ネットワークと QR コードの有効期限を確認してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not reach the PC. Check the network and whether the QR code has expired."
          }
        }
      }
    },

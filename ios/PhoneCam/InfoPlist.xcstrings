{
  "sourceLanguage": "ja",
  "strings": {
    "NSCameraUsageDescription": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配信用カメラとして使用します"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used as the camera for streaming."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi経由でPCの検出と接続を行うために使用します"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to discover and connect to your PC over Wi-Fi."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneのマイク音声をPCへ送るため、録画に音声を入れるために使用します"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to send the iPhone's microphone audio to your PC and to record audio."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録画した動画を写真アプリに保存するために使用します"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to save recorded videos to Photos."
          }
        }
      }
    },
    "CFBundleDisplayName": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PhoneCam"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PhoneCam"
          }
        }
      }
    }
  },
  "version": "1.0"
}